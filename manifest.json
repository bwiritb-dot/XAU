{
  "manifest_version": 3,
  "name": "XAUG — Gold Strategy Terminal",
  "short_name": "XAUG",
  "version": "1.0.0",
  "description": "Торговый терминал XAUUSDT: WSB Order-Flow, Delta Ratio, VWAP, вероятность сигналов W / R, 3-ступенчатый тейк-профит.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "XAUG — Золотой терминал"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://fapi.binance.com/*",
    "wss://fstream.binance.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "trades.csv",
        "lib/lightweight-charts.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://fapi.binance.com wss://fstream.binance.com https://fonts.googleapis.com https://fonts.gstatic.com;"
  }
}
