{
  "manifest_version": 3,
  "name": "XAUG v2",
  "short_name": "XAUG2",
  "version": "2.0.0",
  "description": "XAUUSDT 15m: WSB + Mean Reversion",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
    "default_title": "XAUG v2"
  },
  "background": { "service_worker": "background.js" },
  "permissions": [],
  "host_permissions": ["https://fapi.binance.com/*", "wss://fstream.binance.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://fapi.binance.com wss://fstream.binance.com;"
  }
}
